NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://localhost:27017/leaguelive
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=*

# Auth: set real secrets in every non-development environment.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_REFRESH_TTL=30d
BCRYPT_SALT_ROUNDS=10

# Used only by `npm run seed:platform-operator`.
PLATFORM_OPERATOR_EMAIL=admin@leaguelive.dev
PLATFORM_OPERATOR_NAME=Platform Operator
PLATFORM_OPERATOR_PASSWORD=ChangeMe123!

# FR36 web push. Left unset here on purpose — generate a real pair with
# `npx web-push generate-vapid-keys` and set both. Until both are set,
# notification.service.ts treats push as not configured: subscribe/
# unsubscribe still work, but every send is a silent no-op.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@leaguelive.dev
